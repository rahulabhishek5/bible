# ============================================================
# Bible Web App — .gitignore
# Static JSON Architecture (No Server / No Database Runtime)
# ============================================================

# ---- Dependencies ----
node_modules/
client/node_modules/

# ---- Build Outputs ----
client/dist/
client/build/

# ---- Environment Variables ----
.env
.env.local
.env.*.local
client/.env
client/.env.local

# ---- SQLite Temp Files (keep *.db as source of truth for scripts/) ----
*.db-journal
*.db-wal
*.db-shm

# ---- OS & System Metadata ----
.DS_Store
Thumbs.db
ehthumbs.db

# ---- Editor & IDE Config ----
.vscode/
.idea/
*.suo
*.sln
*.sw?
*.swp

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- AI / Dev Tooling (local only) ----
.agents/
graphify-out/

# ---- One-time scripts no longer needed after JSON generation ----
# (Intentionally NOT ignoring scripts/convert-db-to-json.js — it stays for future
#  new translation additions. Remove this comment if you choose to also ignore it.)
